\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Cross-validation of the open-source propagator against STK Astrogator for $J_2$ + spherical U.S.\ Standard Atmosphere 1976 drag (no SRP), a configuration whose result is attitude-independent. Left: mean semi-major-axis history at 700 and 800~km. Right: the residual (open-source $-$ STK). Two-body plus $J_2$ dynamics agree to $<0.05$~km over 14 days; the drag-induced decay differs by close to an order of magnitude despite matching instantaneous force, identifying drag-force application as the dominant inter-tool difference.}}{21}{figure.caption.11}\protected@file@percent }
\newlabel{fig:stk_validation}{{14}{21}{Cross-validation of the open-source propagator against STK Astrogator for $J_2$ + spherical U.S.\ Standard Atmosphere 1976 drag (no SRP), a configuration whose result is attitude-independent. Left: mean semi-major-axis history at 700 and 800~km. Right: the residual (open-source $-$ STK). Two-body plus $J_2$ dynamics agree to $<0.05$~km over 14 days; the drag-induced decay differs by close to an order of magnitude despite matching instantaneous force, identifying drag-force application as the dominant inter-tool difference}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Independent reproduction of the passive-gain lobe with the open-source propagator: 14-day $\Delta a_{\max }$ over LTDN and sail pitch at 800~km. A single connected positive lobe appears at positive pitch over a bounded LTDN band, in agreement with the location of the reduced-model lobe (Fig.~\ref {fig:heatmap_700km}); the star marks the reduced-model gain anchor.}}{21}{figure.caption.12}\protected@file@percent }
\newlabel{fig:repro_lobe}{{15}{21}{Independent reproduction of the passive-gain lobe with the open-source propagator: 14-day $\Delta a_{\max }$ over LTDN and sail pitch at 800~km. A single connected positive lobe appears at positive pitch over a bounded LTDN band, in agreement with the location of the reduced-model lobe (Fig.~\ref {fig:heatmap_700km}); the star marks the reduced-model gain anchor}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces One-orbit SRP specific power for a reproduced gain case. The dashed curve is the no-eclipse reference; the shaded interval is the umbra. Eclipse removes the negative-work arc, flipping the orbit-averaged SRP work positive --- the eclipse-gating mechanism, reproduced independently.}}{21}{figure.caption.13}\protected@file@percent }
\newlabel{fig:repro_power}{{16}{21}{One-orbit SRP specific power for a reproduced gain case. The dashed curve is the no-eclipse reference; the shaded interval is the umbra. Eclipse removes the negative-work arc, flipping the orbit-averaged SRP work positive --- the eclipse-gating mechanism, reproduced independently}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Reproduced 75-day element evolution. The gain case (800~km, blue) shows the transient, self-limiting signature: mean semi-major axis rises to a peak then declines below its initial value, with apogee pumping, eccentricity growth and perigee erosion. The 700~km reduced-model anchor (red) is drag-dominated and decays to reentry, illustrating the drag sensitivity of the regime.}}{22}{figure.caption.14}\protected@file@percent }
\newlabel{fig:repro_transient}{{17}{22}{Reproduced 75-day element evolution. The gain case (800~km, blue) shows the transient, self-limiting signature: mean semi-major axis rises to a peak then declines below its initial value, with apogee pumping, eccentricity growth and perigee erosion. The 700~km reduced-model anchor (red) is drag-dominated and decays to reentry, illustrating the drag sensitivity of the regime}{figure.caption.14}{}}

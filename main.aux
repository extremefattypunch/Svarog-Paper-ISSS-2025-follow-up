\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Long-horizon summary of the representative \(700\,\mathrm  {km}\) gain case over the \(75\)-day propagation. The case corresponds to altitude \(700\,\mathrm  {km}\), RAAN \(285.5^\circ \), pitch \(24.8^\circ \), LTDN \(12.266\,\mathrm  {hr}\), inclination \(98.2^\circ \), \(e_0=10^{-4}\), sail area \(100\,\mathrm  {m^2}\), mass \(10\,\mathrm  {kg}\), \(C_r=1.7\), and \(C_d=2.2\).}}{12}{table.caption.7}\protected@file@percent }
\newlabel{tab:gaincase_longhorizon_summary}{{4}{12}{Long-horizon summary of the representative \(700\,\mathrm {km}\) gain case over the \(75\)-day propagation. The case corresponds to altitude \(700\,\mathrm {km}\), RAAN \(285.5^\circ \), pitch \(24.8^\circ \), LTDN \(12.266\,\mathrm {hr}\), inclination \(98.2^\circ \), \(e_0=10^{-4}\), sail area \(100\,\mathrm {m^2}\), mass \(10\,\mathrm {kg}\), \(C_r=1.7\), and \(C_d=2.2\)}{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Long-horizon evolution of orbital elements for the representative \(700\,\mathrm  {km}\) gain case, showing non-monotonic semi-major-axis evolution, strong apogee growth, perigee erosion, and eccentricity increase over the \(75\)-day propagation.}}{12}{figure.caption.8}\protected@file@percent }
\newlabel{fig:elementsvstime}{{6}{12}{Long-horizon evolution of orbital elements for the representative \(700\,\mathrm {km}\) gain case, showing non-monotonic semi-major-axis evolution, strong apogee growth, perigee erosion, and eccentricity increase over the \(75\)-day propagation}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Cumulative SRP work, cumulative drag work, and cumulative total work for the representative \(700\,\mathrm  {km}\) gain case over \(75\) days. The cumulative budget remains positive throughout the analysed window, but only narrowly: by day \(75\), cumulative drag has nearly caught up to cumulative SRP.}}{12}{figure.7}\protected@file@percent }
\newlabel{fig:gaincase_cumulative_work_budget}{{7}{12}{Cumulative SRP work, cumulative drag work, and cumulative total work for the representative \(700\,\mathrm {km}\) gain case over \(75\) days. The cumulative budget remains positive throughout the analysed window, but only narrowly: by day \(75\), cumulative drag has nearly caught up to cumulative SRP}{figure.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Early-versus-late comparison for the representative \(700\,\mathrm  {km}\) gain case. The orbit-averaged work budget uses \(20\%\) windows (first and last \(218\) of \(1090\) total orbits), whereas the SRP force-decomposition comparison uses \(10\%\) windows (first and last \(109\) orbits), matching the conventions used in the corresponding figure-generation scripts.}}{13}{table.caption.9}\protected@file@percent }
\newlabel{tab:gaincase_earlylate_comparison}{{5}{13}{Early-versus-late comparison for the representative \(700\,\mathrm {km}\) gain case. The orbit-averaged work budget uses \(20\%\) windows (first and last \(218\) of \(1090\) total orbits), whereas the SRP force-decomposition comparison uses \(10\%\) windows (first and last \(109\) orbits), matching the conventions used in the corresponding figure-generation scripts}{table.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Early-versus-late orbit-averaged work budget for the representative \(700\,\mathrm  {km}\) gain case. The mean SRP contribution collapses strongly between the early and late windows, while the drag penalty remains large, producing a negative late-window net balance.}}{13}{figure.8}\protected@file@percent }
\newlabel{fig:gaincase_early_late_work_comparison}{{8}{13}{Early-versus-late orbit-averaged work budget for the representative \(700\,\mathrm {km}\) gain case. The mean SRP contribution collapses strongly between the early and late windows, while the drag penalty remains large, producing a negative late-window net balance}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Orbit-mean SRP force decomposition for the representative \(700\,\mathrm  {km}\) gain case. The favourable transverse component weakens strongly over time, while the normal component becomes much larger on an early-to-late basis, indicating a substantial redistribution away from the most useful in-plane forcing direction.}}{13}{figure.9}\protected@file@percent }
\newlabel{fig:gaincase_force_decomposition_drift}{{9}{13}{Orbit-mean SRP force decomposition for the representative \(700\,\mathrm {km}\) gain case. The favourable transverse component weakens strongly over time, while the normal component becomes much larger on an early-to-late basis, indicating a substantial redistribution away from the most useful in-plane forcing direction}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Illustration of SRP projection drift for an inertially fixed, spin-stabilised sail in a precessing near-polar orbit. At \(t=0\) (left), the fixed sail normal produces a favourable transverse SRP component \(F_T\). After two months (right), orbital precession changes the Sun-relative orbital geometry, so the same inertially fixed attitude projects less favourably into the local frame, with reduced \(F_T\) and larger normal contribution \(F_N\). This geometric drift contributes to the breakdown of the transient gain regime over longer timescales.}}{14}{figure.caption.10}\protected@file@percent }
\newlabel{fig:precession_drift}{{10}{14}{Illustration of SRP projection drift for an inertially fixed, spin-stabilised sail in a precessing near-polar orbit. At \(t=0\) (left), the fixed sail normal produces a favourable transverse SRP component \(F_T\). After two months (right), orbital precession changes the Sun-relative orbital geometry, so the same inertially fixed attitude projects less favourably into the local frame, with reduced \(F_T\) and larger normal contribution \(F_N\). This geometric drift contributes to the breakdown of the transient gain regime over longer timescales}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8}Robustness and sensitivity of the gain-anchor case}{14}{section.8}\protected@file@percent }
\newlabel{sec:sensitivity}{{8}{14}{Robustness and sensitivity of the gain-anchor case}{section.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}\textbf  {Static roll sensitivity}}{14}{subsection.8.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Sensitivity of the \(14\)-day maximum semi-major-axis increase, \(\Delta a_{\max ,14\mathrm  {d}}\), to static roll offset about the gain-anchor attitude, shown for the same reference geometry propagated at \(700\,\mathrm  {km}\) and \(800\,\mathrm  {km}\). The common geometry is \(\Omega = 285.5^\circ \), LTDN \(=12.266176\,\mathrm  {hr}\), pitch \(24.8^\circ \), zero roll offset, and \(A/m = 10\,\mathrm  {m^2\,kg^{-1}}\). The response peaks at zero roll at both altitudes, but the bounded alignment envelope is substantially broader at \(800\,\mathrm  {km}\).}}{15}{figure.11}\protected@file@percent }
\newlabel{fig:roll_sensitivity_gain_anchor}{{11}{15}{Sensitivity of the \(14\)-day maximum semi-major-axis increase, \(\Delta a_{\max ,14\mathrm {d}}\), to static roll offset about the gain-anchor attitude, shown for the same reference geometry propagated at \(700\,\mathrm {km}\) and \(800\,\mathrm {km}\). The common geometry is \(\Omega = 285.5^\circ \), LTDN \(=12.266176\,\mathrm {hr}\), pitch \(24.8^\circ \), zero roll offset, and \(A/m = 10\,\mathrm {m^2\,kg^{-1}}\). The response peaks at zero roll at both altitudes, but the bounded alignment envelope is substantially broader at \(800\,\mathrm {km}\)}{figure.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}\textbf  {Sensitivity to atmospheric density level}}{15}{subsection.8.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Sensitivity of the \(14\)-day maximum semi-major-axis increase, \(\Delta a_{\max ,14\mathrm  {d}}\), to a multiplicative density scaling applied about the same gain-anchor geometry at \(700\,\mathrm  {km}\) and \(800\,\mathrm  {km}\). Reduced density strengthens the short-horizon gain at both altitudes. Increased density suppresses the \(700\,\mathrm  {km}\) response completely by \(2\times \) nominal density, whereas the \(800\,\mathrm  {km}\) case remains positive throughout the tested range, showing that the drag-limited boundary shifts substantially with altitude.}}{15}{figure.12}\protected@file@percent }
\newlabel{fig:density_sensitivity_gain_anchor}{{12}{15}{Sensitivity of the \(14\)-day maximum semi-major-axis increase, \(\Delta a_{\max ,14\mathrm {d}}\), to a multiplicative density scaling applied about the same gain-anchor geometry at \(700\,\mathrm {km}\) and \(800\,\mathrm {km}\). Reduced density strengthens the short-horizon gain at both altitudes. Increased density suppresses the \(700\,\mathrm {km}\) response completely by \(2\times \) nominal density, whereas the \(800\,\mathrm {km}\) case remains positive throughout the tested range, showing that the drag-limited boundary shifts substantially with altitude}{figure.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3}\textbf  {Sensitivity to area-to-mass ratio}}{15}{subsection.8.3}\protected@file@percent }
\citation{dachwaldOptimalSolarSail2005}
\citation{mcinnes1999}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Sensitivity of the \(14\)-day maximum semi-major-axis increase, \(\Delta a_{\max ,14\mathrm  {d}}\), to sail area-to-mass ratio for the gain-anchor case, with spacecraft mass held fixed at \(10\,\mathrm  {kg}\), shown for the same reference geometry at \(700\,\mathrm  {km}\) and \(800\,\mathrm  {km}\). The \(700\,\mathrm  {km}\) response is non-monotonic, with a broad optimum near \(A/m = 14.4\,\mathrm  {m^2\,kg^{-1}}\), whereas the \(800\,\mathrm  {km}\) response continues to increase across the full sampled range.}}{16}{figure.13}\protected@file@percent }
\newlabel{fig:amr_sensitivity_gain_anchor}{{13}{16}{Sensitivity of the \(14\)-day maximum semi-major-axis increase, \(\Delta a_{\max ,14\mathrm {d}}\), to sail area-to-mass ratio for the gain-anchor case, with spacecraft mass held fixed at \(10\,\mathrm {kg}\), shown for the same reference geometry at \(700\,\mathrm {km}\) and \(800\,\mathrm {km}\). The \(700\,\mathrm {km}\) response is non-monotonic, with a broad optimum near \(A/m = 14.4\,\mathrm {m^2\,kg^{-1}}\), whereas the \(800\,\mathrm {km}\) response continues to increase across the full sampled range}{figure.13}{}}

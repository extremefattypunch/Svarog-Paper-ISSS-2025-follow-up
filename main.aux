\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}\textbf  {Static roll sensitivity}}{16}{subsection.8.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Sensitivity of the \(14\)-day maximum semi-major-axis increase, \(\Delta a_{\max ,14\mathrm  {d}}\), to static roll offset about the gain-anchor attitude, shown for the same reference geometry propagated at \(700\,\mathrm  {km}\) and \(800\,\mathrm  {km}\). The common geometry is \(\Omega = 285.5^\circ \), LTDN \(=12.266176\,\mathrm  {hr}\), pitch \(24.8^\circ \), zero roll offset, and \(A/m = 10\,\mathrm  {m^2\,kg^{-1}}\). The response peaks at zero roll at both altitudes, but the bounded alignment envelope is substantially broader at \(800\,\mathrm  {km}\).}}{17}{figure.11}\protected@file@percent }
\newlabel{fig:roll_sensitivity_gain_anchor}{{11}{17}{Sensitivity of the \(14\)-day maximum semi-major-axis increase, \(\Delta a_{\max ,14\mathrm {d}}\), to static roll offset about the gain-anchor attitude, shown for the same reference geometry propagated at \(700\,\mathrm {km}\) and \(800\,\mathrm {km}\). The common geometry is \(\Omega = 285.5^\circ \), LTDN \(=12.266176\,\mathrm {hr}\), pitch \(24.8^\circ \), zero roll offset, and \(A/m = 10\,\mathrm {m^2\,kg^{-1}}\). The response peaks at zero roll at both altitudes, but the bounded alignment envelope is substantially broader at \(800\,\mathrm {km}\)}{figure.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}\textbf  {Sensitivity to atmospheric density level}}{17}{subsection.8.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Sensitivity of the \(14\)-day maximum semi-major-axis increase, \(\Delta a_{\max ,14\mathrm  {d}}\), to a multiplicative density scaling applied about the same gain-anchor geometry at \(700\,\mathrm  {km}\) and \(800\,\mathrm  {km}\). Reduced density strengthens the short-horizon gain at both altitudes. Increased density suppresses the \(700\,\mathrm  {km}\) response completely by \(2\times \) nominal density, whereas the \(800\,\mathrm  {km}\) case remains positive throughout the tested range, showing that the drag-limited boundary shifts substantially with altitude.}}{17}{figure.12}\protected@file@percent }
\newlabel{fig:density_sensitivity_gain_anchor}{{12}{17}{Sensitivity of the \(14\)-day maximum semi-major-axis increase, \(\Delta a_{\max ,14\mathrm {d}}\), to a multiplicative density scaling applied about the same gain-anchor geometry at \(700\,\mathrm {km}\) and \(800\,\mathrm {km}\). Reduced density strengthens the short-horizon gain at both altitudes. Increased density suppresses the \(700\,\mathrm {km}\) response completely by \(2\times \) nominal density, whereas the \(800\,\mathrm {km}\) case remains positive throughout the tested range, showing that the drag-limited boundary shifts substantially with altitude}{figure.12}{}}

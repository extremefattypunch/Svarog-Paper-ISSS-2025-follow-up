\newlabel{fig:heatmap_700km}{{2}{10}{Maximum semi-major axis change ($\Delta a$) at 700 km as a function of LTDN and sail pitch angle, showing a localised region of net orbital energy gain with dominant decay outcome in the surrounding space}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Comparison of semi-major-axis evolution with eclipse on and off for the representative \(700\,\mathrm  {km}\) gain case, showing that the favourable transient behaviour depends directly on eclipse: with eclipse on, the case reaches \(\Delta a \approx +10.31\,\mathrm  {km}\) by day 14, whereas the eclipse-off counterpart has already fallen to \(\Delta a \approx -47.75\,\mathrm  {km}\).}}{10}{figure.3}\protected@file@percent }
\newlabel{SMA_eclipse}{{3}{10}{Comparison of semi-major-axis evolution with eclipse on and off for the representative \(700\,\mathrm {km}\) gain case, showing that the favourable transient behaviour depends directly on eclipse: with eclipse on, the case reaches \(\Delta a \approx +10.31\,\mathrm {km}\) by day 14, whereas the eclipse-off counterpart has already fallen to \(\Delta a \approx -47.75\,\mathrm {km}\)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Instantaneous SRP specific power, \( \mathbf  {a}_{\mathrm  {SRP}} \!\cdot \! \mathbf  {v} \), over one periapsis-to-periapsis orbit for the representative gain, neutral, and decay cases. The shaded interval marks eclipse, and the dashed curve shows the no-eclipse reference. In the gain case, eclipse suppresses a predominantly negative-power arc; in the neutral and decay cases, it instead suppresses a predominantly positive-power arc.}}{11}{figure.caption.5}\protected@file@percent }
\newlabel{srp_vs_anomaly}{{4}{11}{Instantaneous SRP specific power, \( \mathbf {a}_{\mathrm {SRP}} \!\cdot \! \mathbf {v} \), over one periapsis-to-periapsis orbit for the representative gain, neutral, and decay cases. The shaded interval marks eclipse, and the dashed curve shows the no-eclipse reference. In the gain case, eclipse suppresses a predominantly negative-power arc; in the neutral and decay cases, it instead suppresses a predominantly positive-power arc}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Cumulative SRP specific work over one periapsis-to-periapsis orbit for the representative gain, neutral, and decay cases, with dashed no-eclipse references for comparison. The eclipse-on end values are \(+799.29\,\mathrm  {J\,kg^{-1}}\), \(-665.25\,\mathrm  {J\,kg^{-1}}\), and \(-857.93\,\mathrm  {J\,kg^{-1}}\) respectively, showing that eclipse enhances the SRP budget only in the gain geometry and worsens it in the neutral and decay geometries.}}{11}{figure.caption.6}\protected@file@percent }
\newlabel{cum_SRP}{{5}{11}{Cumulative SRP specific work over one periapsis-to-periapsis orbit for the representative gain, neutral, and decay cases, with dashed no-eclipse references for comparison. The eclipse-on end values are \(+799.29\,\mathrm {J\,kg^{-1}}\), \(-665.25\,\mathrm {J\,kg^{-1}}\), and \(-857.93\,\mathrm {J\,kg^{-1}}\) respectively, showing that eclipse enhances the SRP budget only in the gain geometry and worsens it in the neutral and decay geometries}{figure.caption.6}{}}
